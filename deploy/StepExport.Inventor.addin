  <DisplayName>STEP Export</DisplayName>
  <Description>Export assemblies and parts to STEP, IFC, glTF, OBJ, STL and other files in the folder of the open document, named with the order number and the date.</Description>
  <Assembly>StepExport.dll</Assembly>
  <LoadOnStartUp>1</LoadOnStartUp>
  <UserUnloadable>1</UserUnloadable>
  <Hidden>0</Hidden>
  <SupportedSoftwareVersionGreaterThan>28..</SupportedSoftwareVersionGreaterThan>
  <SupportedSoftwareVersionLessThan>30..</SupportedSoftwareVersionLessThan>
  <DataVersion>1</DataVersion>
  <UserInterfaceVersion>1</UserInterfaceVersion>
  <LoadBehavior>1</LoadBehavior>
</Addin>
